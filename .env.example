# Website build settings — copy to .env (never commit .env). Read by `npm run generate` / `npm run build`.

# Public HTTPS URL of the enquiry server (server/), without a trailing slash.
# Example: https://enquiries.your-domain.com
# Leave empty to build without the enquiry backend (see ENQUIRY_FALLBACK).
ENQUIRY_API_URL=

# What the form does when ENQUIRY_API_URL is empty:
#   netlify — submit to Netlify Forms (works only when the site is hosted on Netlify)
#   none    — the form shows an error instead of pretending to send
ENQUIRY_FALLBACK=netlify
