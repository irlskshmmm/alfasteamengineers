# ASECON enquiry server — copy to .env and fill in. Never commit the real .env.

# --- Server
PORT=8787
HOST=0.0.0.0
# Website origins allowed to submit enquiries (comma-separated, exact scheme + host).
ALLOWED_ORIGINS=https://www.your-domain.com,https://your-domain.com
# Set true when running behind a reverse proxy / load balancer (IIS, Nginx, Render, Azure).
TRUST_PROXY=false
TIMEZONE=Asia/Kolkata
ENQUIRY_ID_PREFIX=ASE
RATE_LIMIT_PER_10MIN=10

# --- Storage (SQLite database + Excel register file). Back up DATA_DIR regularly.
DATA_DIR=./data
# REGISTER_PATH=./data/ASECON-Enquiry-Register.xlsx

# --- Admin dashboard (https://<server>/admin/)
ADMIN_USERNAME=
# Generate with: npm run hash-password -- "a long unique password"
ADMIN_PASSWORD_HASH=
SESSION_TTL_HOURS=8
# Keep true in production (HTTPS). Set false only for local http://localhost testing.
COOKIE_SECURE=true
# Public URL of the dashboard, used in notification emails, e.g. https://enquiries.your-domain.com/admin
PUBLIC_ADMIN_URL=

# --- Live spreadsheet sync: none | microsoft | google
SYNC_PROVIDER=none
SYNC_INTERVAL_SECONDS=60
SYNC_MAX_ATTEMPTS=12

# Microsoft 365 Excel (Option A) — Entra ID app registration with Graph application permission
# Files.ReadWrite.All (or Sites.Selected), admin consent granted.
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# Graph URL of the workbook, e.g. https://graph.microsoft.com/v1.0/drives/{drive-id}/items/{item-id}
MS_WORKBOOK_URL=
MS_TABLE_NAME=Enquiries

# Google Sheets (Option B) — service account; share the sheet with its email as Editor.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the private_key from the JSON key file, keeping the \n sequences.
GOOGLE_PRIVATE_KEY=
GOOGLE_SPREADSHEET_ID=
GOOGLE_SHEET_NAME=Enquiries

# --- Email notification for new enquiries (optional, any SMTP provider)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL_TO=
NOTIFY_EMAIL_FROM=
